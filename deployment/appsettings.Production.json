{
  "ConnectionStrings": {
    "DefaultConnection": "Server=tcp:your-server.database.windows.net,1433;Initial Catalog=ProductInventoryDB;Persist Security Info=False;User ID=your-username;Password=your-password;MultipleActiveResultSets=False;Encrypt=True;TrustServerCertificate=False;Connection Timeout=30;"
  },
  "JwtSettings": {
    "SecretKey": "YourProductionSecretKeyThatShouldBeAtLeast256BitsLongForHS256Algorithm",
    "Issuer": "ProductInventoryAPI",
    "Audience": "ProductInventoryAPI.Users",
    "ExpirationMinutes": 60
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "Microsoft.EntityFrameworkCore.Infrastructure": "Warning"
    },
    "File": {
      "Path": "logs/app-.log",
      "RollingInterval": "Day",
      "RetainedFileCountLimit": 30,
      "FileSizeLimitBytes": 10485760,
      "RollOnFileSizeLimit": true
    }
  },
  "AllowedHosts": "your-domain.com;www.your-domain.com;api.your-domain.com",
  "Cors": {
    "PolicyName": "ProductionCorsPolicy",
    "AllowedOrigins": [
      "https://your-frontend-domain.com",
      "https://www.your-frontend-domain.com"
    ],
    "AllowedMethods": [
      "GET",
      "POST",
      "PUT",
      "DELETE",
      "OPTIONS"
    ],
    "AllowedHeaders": [
      "Authorization",
      "Content-Type",
      "Accept",
      "X-Requested-With"
    ],
    "AllowCredentials": true,
    "MaxAge": 86400
  },
  "HealthChecks": {
    "Enabled": true,
    "DatabaseTimeout": 10,
    "MemoryThreshold": 1073741824,
    "DiskSpaceThreshold": 1073741824
  },
  "RateLimiting": {
    "Enabled": true,
    "GlobalLimit": {
      "PermitLimit": 100,
      "WindowSizeInSeconds": 60,
      "QueueLimit": 10
    },
    "ApiLimit": {
      "PermitLimit": 1000,
      "WindowSizeInSeconds": 3600,
      "QueueLimit": 100
    },
    "AuthLimit": {
      "PermitLimit": 5,
      "WindowSizeInSeconds": 60,
      "QueueLimit": 2
    }
  },
  "ApiVersioning": {
    "DefaultVersion": "1.0",
    "AssumeDefaultVersionWhenUnspecified": true,
    "ApiVersionReader": "UrlSegment",
    "SupportedVersions": [
      "1.0"
    ]
  },
  "Swagger": {
    "Enabled": false,
    "Version": "v1",
    "Title": "Product Inventory API",
    "Description": "Production API for Product Inventory Management System"
  },
  "Performance": {
    "EnableCompression": true,
    "EnableCaching": true,
    "CacheDurationMinutes": 30,
    "MaxRequestSizeBytes": 52428800
  },
  "Security": {
    "RequireHttps": true,
    "EnableHsts": true,
    "HstsMaxAge": 31536000,
    "PasswordPolicy": {
      "RequiredLength": 8,
      "RequireNonAlphanumeric": true,
      "RequireLowercase": true,
      "RequireUppercase": true,
      "RequireDigit": true
    },
    "LockoutPolicy": {
      "DefaultLockoutTimeSpan": "00:15:00",
      "MaxFailedAccessAttempts": 5,
      "AllowedForNewUsers": true
    }
  },
  "Monitoring": {
    "ApplicationInsights": {
      "InstrumentationKey": "your-application-insights-key",
      "EnableRequestTracking": true,
      "EnableDependencyTracking": true,
      "EnablePerformanceCounters": true,
      "EnableExceptionTracking": true
    },
    "HealthCheckUrl": "/health",
    "MetricsUrl": "/metrics"
  }
}